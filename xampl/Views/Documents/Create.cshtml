@model xampl.ViewModels.DocumentVM

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Document</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="DocumentNotes" class="control-label"></label>
                <div id="DocumentNotesContainer">
                    @for (int i = 0; i < Model.DocumentNotes.Count; i++)
                    {
                        <textarea asp-for="DocumentNotes[i].Text" class="form-control noteText"></textarea>
                        <br/>
                    }
                </div>
                <button type="button" class="btn btn-primary" id="addNoteButton">Add Note</button>
            </div>
            <br/>
            <div class="form-group">
                <label asp-for="DocumentLists" class="control-label"></label>
                <div id="DocumentListsContainer">
                    @for (int i = 0; i < Model.DocumentLists.Count; i++)
                    {
                        <div class="noteList">
                            @for (int j = 0; j < Model.DocumentLists[i].DocumentListItems.Count; j++)
                            {
                                <textarea asp-for="DocumentLists[i].DocumentListItems[j].Text" class="form-control noteListItem"></textarea>
                            }
                            <br/>
                            <button type="button" class="btn btn-primary" id="addListItemButton">Add List Item</button>
                        </div>
                    }
                    <br/>
                </div>
                <button type="button" class="btn btn-primary" id="addListButton">Add List</button>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a asp-action="Index">Back</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{await Html.RenderPartialAsync("_DocumentScripts");}
}
