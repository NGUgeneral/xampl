@model xampl.ViewModels.DocumentVM

@{
    ViewData["Title"] = "Edit Document";
}

<h1>Edit</h1>

<h4>Document</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CreatedBy">
            <input type="hidden" asp-for="CreatedAt">
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DocumentNotes" class="control-label"></label>
                <div id="DocumentNotesContainer">
                    @for (int i = 0; i < Model.DocumentNotes.Count; i++)
                    {
                        <textarea asp-for="DocumentNotes[i].Text" class="form-control noteText"></textarea>
                        <div style="text-align: right; width: 100%;">
                            @* TODO: Make this work (pass object to handler in shared DocumentScript) *@
                            <a href="#" class="removeNote text-danger" style="font-size: 0.8em; text-decoration: none;">Remove Note</a>
                        </div>
                        <span asp-validation-for="DocumentNotes[i].Text" class="text-danger"></span>
                        <br />
                    }
                </div>
                <div style="text-align: right;">
                    <button type="button" class="btn btn-sm btn-success" id="addNoteButton">Add Note</button>
                </div>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a asp-action="Index">Back</a>
</div>
<br />
<br />
<br />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{await Html.RenderPartialAsync("_DocumentScripts");}
}
