
@{
    ViewData["Title"] = "Admin";
}

<h1>Admin</h1>

<div class="text-center">
    <p>All the admin tools are in here</p>
</div>

<button id="getQuoteButton" class="btn btn-primary">Get Inspiration Quote</button>
<div id="quoteDisplay" class="mt-3 p-3 border rounded bg-light">
    Get Inspiration!
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_Toast");
    }

    <script>
        document.getElementById('getQuoteButton').addEventListener('click', async () => {
            const quoteDisplay = document.getElementById('quoteDisplay');
            quoteDisplay.innerHTML = 'Loading quote...'; // Show loading message

            try {
                const response = await fetch('/Admin/GetInspirationQuote'); // Make sure this matches your API endpoint
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const data = await response.json();
                quoteDisplay.innerHTML = `"${data.quote}" - ${data.author || 'Unknown'}`; // Assuming quote and optional author
            } catch (error) {
                console.error('Error fetching quote:', error);
                quoteDisplay.innerHTML = 'Failed to load quote. Please try again later.';
            }
        });
    </script>
}
