@using System.Text.Encodings.Web
@model string // This model represents the ID/Name of the hidden input element

@{
    string initialContent = ViewData["InitialContent"] as string;
    string editorHeight = ViewData["EditorHeight"] as string ?? "300px"; // Default height
    string editorPlaceholder = ViewData["EditorPlaceholder"] as string ?? "Enter content..."; // Optional placeholder
}

<div id="@(Model)" style="height: @editorHeight;">
    @Html.Raw(initialContent)
</div>
<input type="hidden" id="hidden-@(Model)" name="@(Model)" value="@Html.Raw(initialContent)" />

<script>
    // This script will run as part of the main page's body content
    document.addEventListener('DOMContentLoaded', function () {
        // Now, Quill should definitely be defined because it's loaded in _Layout.cshtml
        if (typeof Quill === 'undefined') {
            console.error("Quill.js not loaded. Please ensure Quill.js script is referenced in _Layout.cshtml or before this partial.");
            return; // Exit if Quill isn't loaded
        }

        var editorId = '@(Model)';
        var hiddenInputId = 'hidden-' + editorId;
        var hiddenInputElement = document.getElementById(hiddenInputId);

        var quill = new Quill('#' + editorId, {
            theme: 'snow',
            placeholder: '@Html.Raw(JavaScriptEncoder.Default.Encode(editorPlaceholder))',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    [{ 'indent': '-1'}, { 'indent': '+1' }],
                    [{ 'align': [] }],
                    ['link', 'image'],
                    ['clean']
                ]
            }
        });

        // Set initial content
        if (hiddenInputElement.value) {
            quill.clipboard.dangerouslyPasteHTML(hiddenInputElement.value);
        }

        // Handle form submission
        $(document).on('submit', 'form', function(event) {
            var html = quill.root.innerHTML;
            var isEmpty = html === '<p><br></p>' || html.trim() === '';
            hiddenInputElement.value = isEmpty ? '' : html;
        });

        // Optional: Update hidden input on text change
        quill.on('text-change', function(delta, oldDelta, source) {
            if (source === 'user') {
                var html = quill.root.innerHTML;
                var isEmpty = html === '<p><br></p>' || html.trim() === '';
                hiddenInputElement.value = isEmpty ? '' : html;
            }
        });
    });
</script>