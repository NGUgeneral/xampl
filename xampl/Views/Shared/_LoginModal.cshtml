@using xampl.ViewModels;
@model LoginVM;

<div class="modal fade" id="loginModal" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form asp-controller="Account" asp-action="Login">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalLabel">Login</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <br/>
                    <div class="mb-3">
                        <label asp-for="@Model.Email" class="form-label">Email</label>
                        <input asp-for="@Model.Email" class="form-control" required />
                        <span asp-validation-for="@Model.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="@Model.Password" class="form-label">Password</label>
                        <input asp-for="@Model.Password" type="password" class="form-control" required />
                        <span asp-validation-for="@Model.Password" class="text-danger"></span>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Login</button>
                </div>
            </form>
        </div>
    </div>
</div>
