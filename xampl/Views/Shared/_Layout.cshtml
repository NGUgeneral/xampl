@using xampl.ViewModels;
@await Html.PartialAsync("_LoginModal", new LoginVM())

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - xampl</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/xampl.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="About" asp-action="Index">xampl</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Documents" asp-action="Index">Documents</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Users" asp-action="Index">Users</a>
                        </li>
                    </ul>
                    @if (!User?.Identity?.IsAuthenticated ?? true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle focus-ring" type="button" aria-expanded="false" data-bs-toggle="dropdown">
                                Login
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a href="#" class="dropdown-item d-flex align-items-center text-dark login-dropdown-item" data-bs-toggle="modal" data-bs-target="#loginModal">
                                        <img src="/images/user-logo.png" alt="User Logo" width="20" class="me-2"> Sign in
                                    </a>
                                </li>
                                <li>
                                    <a href="/Account/LoginWithGoogle" class="dropdown-item d-flex align-items-center text-dark login-dropdown-item">
                                        <img src="/images/google-logo.png" alt="Google Logo" width="20" class="me-2"> Sign in with Google
                                    </a>
                                </li>
                            </ul>
                        </div>
                        
                    } else {
                        <a href="/Account/Logout" class="btn btn-light d-flex align-items-center text-dark focus-ring">
                            Logout
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - xampl - <a asp-area="" asp-controller="About" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
